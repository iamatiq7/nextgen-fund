rules_version = '2';

// NextGen Fund - Firestore security rules (v3, default-deny).
//
// v3 adds ONE thing to v2: a full-reset capability for the fund admin.
// Reason (audited 2026-09-14): v2 made three stores undeletable by anyone,
// including the admin - /settings/bootstrap, /usernames/* and /audit/*.
// That made it impossible to ever return the app to a clean, first-run
// state: bootstrap kept "an admin already exists" true forever, and a
// leftover /usernames/{name} blocked that username from being reused
// (create on an existing doc is an update, and update stays false).
//
// What changed, precisely:
//   settings/bootstrap : delete allowed for the admin (was: never)
//   usernames/{name}   : delete allowed for the admin (was: never)
//   audit/{id}         : delete allowed for the admin (was: never)
// Everything else is byte-identical to v2. Updates stay forbidden everywhere
// they were forbidden: identity is still immutable, the audit log is still
// append-only in normal operation, and no member gains any new power.
//
// RISK NOTE (read before releasing the bootstrap): deleting
// /settings/bootstrap puts the app back into first-run mode, because admin
// setup is claimable whenever the doc is absent - that is the intended
// "start from new" behaviour. Do it deliberately, and create the new admin
// immediately afterwards at setup.html.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function hasBoot() { return exists(/databases/$(database)/documents/settings/bootstrap); }
    function boot() { return get(/databases/$(database)/documents/settings/bootstrap).data; }
    function isAdmin() {
      return isSignedIn() && hasBoot() && boot().adminUid == request.auth.uid;
    }

    // Public settings: dashboard reads; only admin writes (delete included).
    // Drive upload endpoint (added 2026-09-15): register.html reads it before sign-in,
    // so the read is public; only the fund admin may change it.
    match /settings/drive {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/public {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // One-time bootstrap slot: the first admin claims it. Immutable once claimed,
    // EXCEPT that the admin may release it (full reset back to first-run).
    match /settings/bootstrap {
      allow get: if true;
      // NB: /settings/public and /settings/bootstrap are matched by document path,
      // so no per-id block can ever grant a collection *list*. A reset therefore
      // reaches these two by id (it knows both paths) rather than by enumerating.
      allow create: if isSignedIn() && !hasBoot();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Public finance aggregates (funding / revenue / loss).
    match /finance/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Users: admins read/see all; members read their own.
    // Self-create is allowed for (a) a pending member after setup, or
    // (b) exactly the uid that claimed bootstrap (admin setup).
    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(uid) && hasBoot() && (
          (request.resource.data.role == 'member' && request.resource.data.status == 'pending') ||
          (request.resource.data.role == 'admin' && boot().adminUid == request.auth.uid)
        );
      // Members may not change identity or money fields on their own doc.
      allow update: if isAdmin() || (isSelf(uid) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.username == resource.data.username &&
          request.resource.data.shares == resource.data.shares &&
          request.resource.data.monthlyDue == resource.data.monthlyDue &&
          request.resource.data.joinMonth == resource.data.joinMonth);
      allow delete: if isAdmin();
    }

    // Username -> {uid, email}: public read (needed for username login),
    // created once by the owner (or admin). Never updatable; deletable by the
    // admin so a reset can free the handle for reuse.
    match /usernames/{name} {
      allow get: if true;
      // as above: the reset has to enumerate every handle to free them for reuse
      allow list: if isAdmin();
      allow create: if isSelf(request.resource.data.uid) || isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Registrations: submitted by applicants (pending only); admins decide.
    match /registrations/{id} {
      allow create: if request.resource.data.status == 'pending';
      allow get, list: if isSelf(resource.data.__ownerUid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Payments: members create their OWN pending credits; admins manage all.
    // Credits must be whole multiples of 1,000 tk (1000, 2000, 3000, ...).
    match /payments/{id} {
      allow create: if isAdmin() || (
          isSignedIn() &&
          request.resource.data.memberId == request.auth.uid &&
          request.resource.data.amount is number &&
          request.resource.data.amount >= 1000 &&
          request.resource.data.amount % 1000 == 0 &&
          request.resource.data.status == 'pending' &&
          request.resource.data.type in ['due', 'advance'] &&
          request.resource.data.verifiedAt == null &&
          request.resource.data.verifiedBy == null
        );
      allow get, list: if (isSignedIn() && resource.data.memberId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Audit log: append-only in normal operation (read/delete: admin only).
    /* ---- nominee change requests: the member asks, only an admin decides ---- */
    match /nomineeRequests/{id} {
      allow create: if isSignedIn()
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedNominee is string
        && request.resource.data.requestedNominee.size() > 1;
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
