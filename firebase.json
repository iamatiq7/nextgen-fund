{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            ".firebaserc",
            "**/.*",
            "**/node_modules/**",
            "docs/**",
            "tests/**",
            "*.md",
            "ops/**"
        ],
        "headers": [
            {
                "source": "**/*.@(js|css|png|svg|ico)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, must-revalidate"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "firestore": {
        "rules": "firestore.rules"
    }
}
