{
    "hosting":  {
                    "public":  ".",
                    "ignore":  [
                                   "firebase.json",
                                   ".firebaserc",
                                   "**/.*",
                                   "**/node_modules/**",
                                   "docs/**",
                                   "tests/**",
                                   "*.md",
                                   "ops/**"
                               ],
                    "headers":  [
                                    {
                                        "source":  "**/*.@(js|css|png|svg|ico)",
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "public, max-age=600"
                                                        }
                                                    ]
                                    }
                                ],
                    "rewrites":  [
                                     {
                                         "source":  "**",
                                         "destination":  "/index.html"
                                     }
                                 ]
                }
}
